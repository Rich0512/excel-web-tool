{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryDirectory": "~/.claude/projects/excel-web-tool/memory",
  "permissions": {
    "allow": [
      "Bash(node tools/check-site.mjs *)",
      "Bash(node tools/bump-version.mjs *)",
      "Bash(node tools/test-hooks.mjs *)",
      "Bash(node tools/test-site.mjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(node tools/check-site.mjs *)",
      "PowerShell(node tools/bump-version.mjs *)",
      "PowerShell(node tools/test-hooks.mjs *)",
      "PowerShell(node tools/test-site.mjs *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh api *)",
      "PowerShell(git push *)",
      "PowerShell(gh api *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-roster.mjs"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.mjs"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.mjs"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
